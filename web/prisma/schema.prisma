generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  cpf          String?
  createdAt    DateTime @default(now())

  address   Address?
  favorites Favorite[]
  cartItems CartItem[]
  orders    Order[]
  measurements Measurement?
}

model Address {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  number    String?
  district  String?
  city      String
  state     String
  zip       String
  preference String @default("motoboy")
}

model Measurement {
  id         String @id @default(cuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  anelAro    Int?
  correnteCm Int?
  pulseiraCm Int?
  paymentPref String @default("pix")
  cardLast4   String?
}

model Category {
  id       String    @id
  name     String
  iconName String
  photoId  Int
  products Product[]
}

model Product {
  id            String   @id
  name          String
  spec          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  price         Float
  oldPrice      Float?
  photoId       Int
  tags          String   @default("[]")
  buildTipo     String
  buildElo      String?
  buildEsp      Float
  buildMedida   Int?
  buildPingente String?
  buildSinete   Boolean  @default(false)
  buildGravacao String?

  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([guestToken])
}

model CartItem {
  id          String   @id @default(cuid())
  cartToken   String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int      @default(1)
  customName  String?
  customSpec  String?
  customPrice Float?
  customSpecJson String?
  createdAt   DateTime @default(now())

  @@index([cartToken])
}

model Order {
  id           Int         @id @default(autoincrement())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  status       String      @default("preparo")
  customerName String
  customerPhone String
  customerCpf  String?
  zip          String
  addressNumber String?
  delivery     String
  payment      String
  subtotal     Float
  discount     Float       @default(0)
  shipping     Float       @default(0)
  total        Float
  createdAt    DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  name        String
  spec        String
  quantity    Int
  unitPrice   Float
  oldUnitPrice Float?
}
