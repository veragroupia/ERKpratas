{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/loja/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|nome|icone|href|contador|key|ref|className|style|children)$/]",
        "message": "<BottomBarItem> doesn't accept that prop. Declared props: id, nome, icone, href, contador."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheetOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|nome|contagem|key|ref|className|style|children)$/]",
        "message": "<BottomSheetOption> doesn't accept that prop. Declared props: id, nome, contagem."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|icone|iconeAntes|full|disabled|onClick|target|rel|type|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, icone, iconeAntes, full, disabled, onClick, target, rel, type, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|nome|icone|href|promo|key|ref|className|style|children)$/]",
        "message": "<CategoryNavItem> doesn't accept that prop. Declared props: id, nome, icone, href, promo."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:nome|contagem|foto|href|onClick|className|key|ref|className|style|children)$/]",
        "message": "<CategoryTile> doesn't accept that prop. Declared props: nome, contagem, foto, href, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|ativo|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, ativo, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:titulo|texto|acao|acaoHref|className|key|ref|className|style|children)$/]",
        "message": "<CTABanner> doesn't accept that prop. Declared props: titulo, texto, acao, acaoHref, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:titulo|itens|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: titulo, itens."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuaranteeItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icone|titulo|texto|key|ref|className|style|children)$/]",
        "message": "<GuaranteeItem> doesn't accept that prop. Declared props: icone, titulo, texto."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:itensSacola|busca|onBusca|onSubmitBusca|onAbrirBusca|semBusca|className|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: itensSacola, busca, onBusca, onSubmitBusca, onAbrirBusca, semBusca, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroProva'] > JSXAttribute > JSXIdentifier[name!=/^(?:icone|texto|key|ref|className|style|children)$/]",
        "message": "<HeroProva> doesn't accept that prop. Declared props: icone, texto."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|className|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style, className, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icone|rotulo|contador|href|onClick|ariaLabel|className|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icone, rotulo, contador, href, onClick, ariaLabel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|linha|compacto|className|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: href, linha, compacto, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Price'] > JSXAttribute > JSXIdentifier[name!=/^(?:valor|antigo|parcela|grande|className|key|ref|className|style|children)$/]",
        "message": "<Price> doesn't accept that prop. Declared props: valor, antigo, parcela, grande, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:nome|categoria|spec|foto|valor|antigo|parcela|tags|desconto|favorito|onFavorito|href|acao|acaoHref|onAcao|onAdicionar|className|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: nome, categoria, spec, foto, valor, antigo, parcela, tags, desconto, favorito, onFavorito, href, acao, acaoHref, onAcao, onAdicionar, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:nome|spec|foto|valor|href|direita|onClick|className|key|ref|className|style|children)$/]",
        "message": "<ProductRow> doesn't accept that prop. Declared props: nome, spec, foto, valor, href, direita, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:olho|titulo|texto|foto|acao|acaoHref|acento|className|key|ref|className|style|children)$/]",
        "message": "<PromoBanner> doesn't accept that prop. Declared props: olho, titulo, texto, foto, acao, acaoHref, acento, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|valor|onChange|onSubmit|botao|semBotao|className|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: placeholder, valor, onChange, onSubmit, botao, semBotao, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:titulo|apoio|link|linkHref|onLink|className|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: titulo, apoio, link, linkHref, onLink, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|oferta|className|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, oferta, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
